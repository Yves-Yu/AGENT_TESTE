# =====================================================================
# Shopping Agent — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores necessários.
# =====================================================================

# --- Provider do LLM (opcional — padrão: anthropic) ---
# Troque para "gemini" para rodar o agente de graça com a API do Gemini
# (sujeita a limites de uso gratuito), sem precisar mudar nada no código —
# agent.py e selector_agent.py funcionam do mesmo jeito com qualquer provider.
LLM_PROVIDER=anthropic

# --- Anthropic (obrigatório se LLM_PROVIDER=anthropic) ---
ANTHROPIC_API_KEY=...

# --- Gemini (obrigatório se LLM_PROVIDER=gemini) ---
# Key gratuita em https://aistudio.google.com/apikey
GEMINI_API_KEY=...

# --- Modelos ---
# LLM_MODEL: raciocínio principal do agente — claude-sonnet-4-6 (padrão).
# LLM_MODEL_SELECTOR: sub-agente que só gera JSON de seletores CSS/XPath a
# partir de HTML — tarefa mais estruturada e simples, por isso usa um modelo
# mais barato (claude-haiku-4-5) por padrão. O gate de confiança em
# app/tools/extract.py (conf < 0.3) cobre seletores de baixa qualidade.
# Se LLM_PROVIDER=gemini, troque os dois abaixo para modelos Gemini, ex.:
#   LLM_MODEL=gemini-3.5-flash
#   LLM_MODEL_SELECTOR=gemini-3.5-flash-lite
# (confira o nome mais recente em https://ai.google.dev/gemini-api/docs/models —
# esses nomes mudam com frequência)
LLM_MODEL=claude-sonnet-4-6
LLM_MODEL_SELECTOR=claude-haiku-4-5
LLM_MAX_TOKENS=2000
# Quantas mensagens manter no histórico entre turnos da mesma conversa
# (agent.py) antes de truncar — evita custo/latência crescendo sem limite
# em conversas longas.
HISTORY_MAX_MESSAGES=20

# --- Observabilidade ---
DB_PATH=data/traces.sqlite3
LOG_LEVEL=INFO

# --- Browser automation ---
HEADLESS=true
NAV_TIMEOUT_MS=20000
MAX_SITES_PER_SEARCH=5

# --- Servidor web ---
HOST=0.0.0.0
PORT=8000


# --- Prompt externo (opcional) ---
# Aponte para um JSON com as chaves MAIN_AGENT_SYSTEM_PROMPT,
# SELECTOR_AGENT_SYSTEM_PROMPT e/ou SELECTOR_VALIDATION_PROMPT_TEMPLATE
# para sobrescrever os prompts padrão em runtime (sem redeploy).
PROMPT_FILE=
